# Core web app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_TEST_AUTH=
NEXT_PUBLIC_TEST_AUTH_EMAIL=
NEXT_PUBLIC_TEST_AUTH_PASSWORD=
NEXT_PUBLIC_SKIP_AUTH_EMAIL=
NEXT_PUBLIC_SKIP_AUTH_PASSWORD=
NEXT_PUBLIC_ENABLE_IMAGE_PROXY=
NEXT_PUBLIC_ASSET_PREFIX=

# Android shell (ui/shell)
# Where each variant is deployed on the web. The shell's own origin is https://localhost,
# so share links must use these; sharing reports "not configured" when they are unset.
NEXT_PUBLIC_PUBLIC_WEB_ORIGIN_DEV=
NEXT_PUBLIC_PUBLIC_WEB_ORIGIN_STAGE=
NEXT_PUBLIC_PUBLIC_WEB_ORIGIN_PROD=
# Per-variant Supabase projects. Stage falls back to NEXT_PUBLIC_SUPABASE_URL above;
# prod must be set explicitly, so a prod build can never inherit a non-prod project.
NEXT_PUBLIC_SUPABASE_URL_STAGE=
NEXT_PUBLIC_SUPABASE_ANON_KEY_STAGE=
NEXT_PUBLIC_SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=

# Local Supabase tooling
SUPABASE_URL=http://127.0.0.1:54321
# Legacy alias used by local Node scripts (same secret as service role key).
SUPABASE_SERVICE_KEY=

# RAG / AI indexing
# GEMINI_API_KEY is no longer used server-side; users provide their key via Settings → API Keys.
# AI_CREDENTIALS_KEY is the server-side AES-GCM encryption secret for user API keys.
# Generate with: openssl rand -base64 32
AI_CREDENTIALS_KEY=
# Canonical name used by Supabase Edge Functions (preferred in new code/docs).
SUPABASE_SERVICE_ROLE_KEY=

# Test users and scripts
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_EMAIL=
TEST_PASSWORD=
