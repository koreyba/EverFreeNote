{
  "name": "everfreenote-capacitor-poc",
  "version": "0.0.1",
  "private": true,
  "description": "POC: Capacitor shell wrapping the existing Next.js static export",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "sync": "npm run build:web && npx cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1"
  }
}
