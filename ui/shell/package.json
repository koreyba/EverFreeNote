{
  "name": "everfreenote-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Android shell: runs the EverFreeNote web build as a native app via Capacitor",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "add:android": "node scripts/add-android.js",
    "assets:generate": "node scripts/generate-assets.js",
    "sync": "node scripts/build-web.js && npx cap sync android",
    "android:dev": "cross-env APP_VARIANT=dev node scripts/build-apk.js debug",
    "android:stage": "cross-env APP_VARIANT=stage node scripts/build-apk.js debug",
    "android:stage:release": "cross-env APP_VARIANT=stage node scripts/build-apk.js release",
    "android:prod": "cross-env APP_VARIANT=prod node scripts/build-apk.js debug",
    "android:prod:release": "cross-env APP_VARIANT=prod node scripts/build-apk.js release",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.1",
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2"
  }
}
